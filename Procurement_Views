 -- Total Procurement Spend --
CREATE VIEW vw_TotalProcurementSpend AS
SELECT
SUM(Dollars) AS TotalProcurementSpend
FROM vw_ProcurementBase;

-- Spend by Vendor
CREATE OR ALTER VIEW vw_SpendByVendor AS
SELECT
    VendorNumber,
    VendorName,
    SUM(Dollars) AS TotalSpend,
    COUNT(*) AS PurchaseCount
FROM vw_ProcurementBase
GROUP BY
    VendorNumber,
    VendorName;

-- Spend by Brand --
CREATE OR ALTER VIEW vw_SpendByBrand AS 
SELECT
    Brand,
    SUM(Dollars) AS TotalSpend,
    SUM(Quantity) AS TotalQuantity
FROM vw_ProcurementBase
GROUP BY
    Brand

-- Monthly Procurement Spend --
CREATE OR ALTER VIEW vw_MonthlySpend AS
SELECT
    YEAR(PODate) AS PurchaseYear,
    MONTH(PODate) AS PurchaseMonth,
    SUM(Dollars) AS TotalSpend
FROM vw_ProcurementBase
GROUP BY
    YEAR(PODate),
    MONTH(PODate)

-- POAnalysis --
CREATE OR ALTER VIEW vw_POAnalysis AS
SELECT
    COUNT(DISTINCT PONumber) AS TotalPOs,
    ROUND(SUM(Dollars) * 1.0 / COUNT(DISTINCT PONumber), 2) AS AveragePOValue
FROM vw_ProcurementBase;


-- Price Variance --
CREATE OR ALTER VIEW vw_PriceVariance AS
SELECT
    Brand,
    Description,
    PurchasePrice,
    ListPrice,
    (PurchasePrice - ListPrice) AS PriceVariance,
    ROUND(
        ((ListPrice - PurchasePrice) / NULLIF(ListPrice, 0)) * 100,
        2
    ) AS PriceVariancePct
FROM vw_ProcurementBase;

-- Vendor Concentration / Pareto (80-20) --
CREATE OR ALTER VIEW vw_VendorConcentration AS
SELECT
    VendorNumber,
    VendorName,
    SUM(Dollars) AS VendorSpend
FROM vw_ProcurementBase
GROUP BY
    VendorNumber,
    VendorName;


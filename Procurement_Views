-- vw_ProcurementBase (purchases + purchase_prices) + vendor_invoice --

CREATE OR ALTER VIEW vw_ProcurementFull AS
SELECT
    pb.*,
    vi.InvoiceDate,vi.PayDate,vi.Approval,
    vi.Quantity AS InvoiceQuantity,
    vi.Dollars AS InvoiceDollars,
    vi.Freight
FROM vw_ProcurementBase pb
LEFT JOIN vendor_invoice vi
    ON pb.VendorNumber = vi.VendorNumber
    AND pb.PONumber = vi.PONumber;

-- Total Invoice Amount --
SELECT SUM(InvoiceDollars) AS TotalInvoiceAmount
FROM vw_ProcurementFull;

-- Total Freight Cost --
SELECT SUM(Freight) AS TotalFreightCost
FROM vw_ProcurementFull;

-- Vendors with Highest Invoice Amount --
SELECT
    VendorNumber,
    VendorName,
    SUM(InvoiceDollars) AS Total_InvoiceAmount
FROM vw_ProcurementFull
GROUP BY VendorNumber, VendorName
ORDER BY Total_InvoiceAmount DESC;

-- Freight Cost per Unit --
SELECT
    VendorNumber,
    VendorName,
    SUM(CAST(Freight AS DECIMAL(18,2))) AS TotalFreight,
    SUM(CAST(InvoiceQuantity AS BIGINT)) AS TotalQuantity,
    ROUND(SUM(CAST(Freight AS DECIMAL(18,2))) / NULLIF(SUM(CAST(InvoiceQuantity AS BIGINT)), 0), 2) AS FreightPerUnit
FROM vw_ProcurementFull
GROUP BY VendorNumber, VendorName
ORDER BY FreightPerUnit DESC;

-- Payment Timing (PayDate vs InvoiceDate, days to pay) --
SELECT
    VendorNumber,
    VendorName,
    AVG(DATEDIFF(DAY, InvoiceDate, PayDate)) AS AvgDaysToPay
FROM vw_ProcurementFull
GROUP BY VendorNumber, VendorName
ORDER BY AvgDaysToPay DESC;

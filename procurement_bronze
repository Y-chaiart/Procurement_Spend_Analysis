CREATE TABLE begin_inventory (
    InventoryId VARCHAR(50),
    Store INT,
    City VARCHAR(100),
    Brand INT,
    Description VARCHAR(255),
    Size VARCHAR(50),
    onHand INT,
    Price DECIMAL(10,2),
    startDate DATE
);
BULK INSERT dbo.begin_inventory
FROM 'C:\Inventory_Data\begin_inventory.csv'
WITH (
    FIRSTROW = 2,
    FIELDTERMINATOR = ',',
    ROWTERMINATOR = '0x0d0a',
    TABLOCK
);

CREATE TABLE end_inventory (

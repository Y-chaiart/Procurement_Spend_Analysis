CREATE TABLE purchase_prices (
    Brand INT,
    Description VARCHAR(255),
    Price DECIMAL(10,2),
    Size VARCHAR(50),
    Volume varchar(20),
    Classification INT,
    PurchasePrice DECIMAL(10,2),
    VendorNumber INT,
    VendorName VARCHAR(255)
); 

BULK INSERT dbo.purchase_prices
FROM 'C:\Inventory_Data\purchase_prices.csv'
WITH (
    FIRSTROW = 2,
    FIELDTERMINATOR = ',',
    ROWTERMINATOR = '0x0d0a',
    TABLOCK
);

CREATE TABLE purchases (
    InventoryId VARCHAR(50),
    Store INT,
    Brand INT,
    Description VARCHAR(255),
    Size VARCHAR(50),
    VendorNumber int,
    VendorName VARCHAR(255),
    PONumber varchar(20),
    PODate varchar(20),
    ReceivingDate DATE,
    InvoiceDate DATE,
    PayDate DATE,
    PurchasePrice varchar(20),
    Quantity varchar(20),
    Dollars decimal(18,2),
    Classification varchar(20)
);

BULK INSERT dbo.purchases
FROM 'C:\Inventory_Data\purchases.csv'
WITH (
    FORMAT = 'CSV',
    FIRSTROW = 2,
    FIELDQUOTE = '"',
    FIELDTERMINATOR = ',',
    ROWTERMINATOR = '0x0a',
    TABLOCK,
    CODEPAGE = '65001'   -- add if you hit any encoding/odd character issues
);

CREATE TABLE dbo.sales (

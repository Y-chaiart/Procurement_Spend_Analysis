--  Begin inventory --
select  top 15 * from dbo.begin_inventory;

-- Data Profiling --
SELECT
    COUNT(*) AS TotalRows,
    COUNT(DISTINCT InventoryId) AS UniqueInventoryIds,
    MIN(startDate) AS MinDate,
    MAX(startDate) AS MaxDate,
    MIN(Price) AS MinPrice,
    MAX(Price) AS MaxPrice,
    MIN(onHand) AS MinOnHand,
    MAX(onHand) AS MaxOnHand
FROM dbo.begin_inventory;

-- Data cleaning --
-- 1. Duplicate checks --
SELECT
    InventoryId,
    COUNT(*) AS DuplicateCount
FROM dbo.begin_inventory
GROUP BY InventoryId
HAVING COUNT(*) > 1;

-- 2. Null checks --
SELECT
    SUM(CASE WHEN InventoryId IS NULL THEN 1 ELSE 0 END) AS InventoryId_Nulls,
    SUM(CASE WHEN Store IS NULL THEN 1 ELSE 0 END) AS Store_Nulls,
    SUM(CASE WHEN City IS NULL THEN 1 ELSE 0 END) AS City_Nulls,
    SUM(CASE WHEN Brand IS NULL THEN 1 ELSE 0 END) AS Brand_Nulls,
    SUM(CASE WHEN Description IS NULL THEN 1 ELSE 0 END) AS Description_Nulls,
    SUM(CASE WHEN Size IS NULL THEN 1 ELSE 0 END) AS Size_Nulls,
    SUM(CASE WHEN onHand IS NULL THEN 1 ELSE 0 END) AS onHand_Nulls,
    SUM(CASE WHEN Price IS NULL THEN 1 ELSE 0 END) AS Price_Nulls,
    SUM(CASE WHEN startDate IS NULL THEN 1 ELSE 0 END) AS startDate_Nulls
FROM dbo.begin_inventory;

-- 3. Invalid values --
SELECT *
FROM dbo.begin_inventory
WHERE onHand < 0
   OR Price < 0;

-- 4. Price check --
SELECT *
FROM dbo.begin_inventory
WHERE Price = 0;
-- 2 records have Price = 0. --

-- 5. Date check --
SELECT *
FROM dbo.begin_inventory
WHERE startDate IS NULL
   OR startDate > GETDATE();

-- 6. Leading\Trailing spaces --
SELECT *
FROM dbo.begin_inventory
WHERE City <> TRIM(City)
   OR Description <> TRIM(Description)
   OR Size <> TRIM(Size);

-- 7. Blank Values --
SELECT *
FROM dbo.begin_inventory
WHERE City = ''
   OR Description = ''
   OR Size = '';

-- Business Validation Checks --

--  1. Check City/Store consistency --
-- Same store should map to only one city
SELECT Store, COUNT(DISTINCT City) AS CityCount
FROM begin_inventory
GROUP BY Store
HAVING COUNT(DISTINCT City) > 1;

-- 2. One Brand / One Description --
SELECT Brand
FROM begin_inventory
GROUP BY Brand
HAVING COUNT(DISTINCT Description) > 1;

-- 3. One Brand → One Size --
SELECT Brand
FROM begin_inventory
GROUP BY Brand
HAVING COUNT(DISTINCT Size) > 1;
